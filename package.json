{
  "name": "audio-project-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop audio project management application",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "concurrently -k \"pnpm --filter renderer dev\" \"pnpm --filter electron-main wait-and-dev\"",
    "build": "pnpm -r build",
    "build:electron": "pnpm --filter electron-main build",
    "build:renderer": "pnpm --filter renderer build",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "vitest",
    "test:unit": "vitest run",
    "e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/reset-db.js",
    "check:demucs": "python electron/scripts/check_demucs.py",
    "install:demucs": "pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu && pip install demucs",
    "package": "pnpm build && electron-builder",
    "package:win": "pnpm build && electron-builder --win",
    "package:mac": "pnpm build && electron-builder --mac",
    "package:linux": "pnpm build && electron-builder --linux",
    "clean": "rimraf dist electron/dist renderer/dist node_modules/.cache",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4",
    "wait-on": "^9.0.1"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "prisma": "^5.7.1"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.2.43",
      "@types/react-dom": "^18.2.17"
    },
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.audioproject.manager",
    "productName": "Audio Project Manager",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/dist/**/*",
      "renderer/dist/**/*",
      "prisma/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Audio"
    }
  }
}
